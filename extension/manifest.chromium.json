{
  "manifest_version": 3,
  "name": "remobro",
  "version": "0.2.0",
  "description": "Lets your AI agents (Claude Code, Codex, any MCP client) drive this browser, with a visible 'AI is driving' overlay.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "webRequest",
    "notifications",
    "alarms",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "remobro",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "minimum_chrome_version": "116"
}
