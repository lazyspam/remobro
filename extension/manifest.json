{
  "manifest_version": 2,
  "name": "Zen Pilot",
  "version": "0.2.0",
  "description": "Lets your AI agents (Claude Code, Codex, any MCP client) drive this browser, with a visible 'AI is driving' overlay.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "webRequest",
    "notifications",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Zen Pilot",
    "default_icon": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "zen-pilot@local",
      "strict_min_version": "128.0",
      "update_url": "https://github.com/iput-object/zen-pilot/releases/latest/download/updates.json"
    }
  }
}
