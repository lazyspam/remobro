{
  "manifest_version": 2,
  "name": "remobro",
  "version": "0.2.0",
  "description": "Lets your AI agents (Claude Code, Codex, any MCP client) drive this browser, with a visible 'AI is driving' overlay.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon.svg",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "webRequest",
    "notifications",
    "alarms",
    "scripting",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "remobro",
    "default_icon": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "remobro@iput-object",
      "strict_min_version": "128.0",
      "update_url": "https://github.com/iput-object/remobro/releases/latest/download/updates.json"
    }
  }
}
